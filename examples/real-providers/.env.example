# examples/real-providers 用到的环境变量。复制成 .env 并填入真实取值：
#
#   cp examples/real-providers/.env.example examples/real-providers/.env
#   set -a; . examples/real-providers/.env; set +a
#   XDG_STATE_HOME=$(mktemp -d) nova run -c examples/real-providers/Novafile
#
# 配置里的 listen / admin 是 nova 的缺省端口（127.0.0.1:8080 与 127.0.0.1:2026）。
# 本机已有一个 nova 在跑时先改这两行，否则会得到「端口被占用」而不是「配置写错了」。
# XDG_STATE_HOME 同样只是为了让示例的统计不写进真实运行用的那份库；正式部署时去掉它。
#
# nova 自己不读 .env：环境变量从哪来（shell、systemd EnvironmentFile、容器编排）
# 是运行环境的事，配置只声明变量名。缺失或为空都会在加载时报错，而不是当成空密钥放行。
#
# 本文件不含任何真实凭据，`.env` 已被 .gitignore 挡住。

NOVA_CLIENT_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RELAY_API_KEY=

# nova 配置示例。
#
# 复制到 ${XDG_CONFIG_HOME:-$HOME/.config}/nova/Novafile 即为缺省配置，
# 或用 `nova run -c <路径>`、环境变量 NOVA_CONFIG 指向别处。
#
# 语法要点：
#   - `#` 到行尾是注释；
#   - 指令直接写在顶层，一行一条；只有要绑定「地址 + 它提供哪些模型」时才用花括号；
#   - 一行是「指令名 取值...」，取值含空白时用双引号包住，引号内 `\"` 与 `\\` 是转义；
#   - 取值里的 {env.NAME} 在加载时替换为环境变量 NAME 的取值。
#
# 用 `nova config check -c Novafile` 可以在不启动、不连上游的前提下校验这份文件。

# 这份配置按哪一代语法书写。
# 省略时按本二进制实现的最高代数解析，并记一条提示；写出来的代数超出本二进制支持的
# 区间时，nova 在解析任何指令之前就失败，并说明是文件声明的代数高、还是本二进制太旧。
version 1

# 日志级别：debug / info / warn / error（缺省 info）。
#
# 它决定「哪些记录被输出」，不决定记录长什么样：
#   - 访问日志按 HTTP 状态码分档：5xx 记 error、4xx 记 warn、其余记 info；
#   - 上游尝试按结果分档：成功 info、失败 warn、客户端取消 debug
#     （取消记 debug 是有意的：长流场景下客户端主动断开很常见，记 warn 会把真故障淹没）。
#
# 启动横幅不受它影响：横幅回答的是「这个进程在用哪份配置跑」，
# 挂到 log_level 上会让一个 log_level error 的实例看不出自己监听在哪。
log_level info

# 日志格式：text / json（缺省 text）。
#
#   - text 给人读：一行一条，字段顺序固定，同协议不写协议、同模型不写模型、
#     用量只写非零子项；失败时上游的状态码与响应片段另起一行缩进排。
#     它因此是不可逆的，不能当数据源。
#   - json 给机器读：字段齐全，用量收在一个 usage 对象里，时间戳是 RFC3339。
#     重定向到文件或喂给采集器时用它。
#
# 终端能不能显示颜色不是配置项，而是运行时判定：
# 输出落在终端上、未设 NO_COLOR、且 TERM 不是 dumb 时才着色。
log_format text

# 数据面监听地址（缺省 127.0.0.1:8080，只绑回环）。客户端请求从这个地址进来。
# 要对内网或公网服务就写 listen :8080 或某个具体地址；
# 那时若没有 client_key，会记一条「谁都能用你的上游凭据」的警告。
listen 127.0.0.1:8080

# 管理端点地址（缺省 localhost:2026）。
# `nova run` 除了数据面之外还会在这个地址上多监听一个管理端点，`nova reload` 按它把
# 「重新加载配置」投递进来。它没有鉴权：能连上它的人就能改写这份运行中的配置，
# 因此缺省只绑回环；绑到非回环地址会记一条警告。
admin 127.0.0.1:2026

# 客户端凭据：允许调用这个网关的 key，可写多条。
# 客户端用 `Authorization: Bearer <key>` 或 `x-api-key: <key>` 提交，任一匹配即放行。
# 不写这一条就是不鉴权——那种配置只在 listen 也绑回环时才安全，否则会记一条警告。
client_key {env.NOVA_CLIENT_KEY}

# ── 上游渠道 ─────────────────────────────────────────────────────────────────
#
# `provider <名>` 描述一条上游渠道。名字只用于日志与错误定位，不参与选路，
# 因此重名会被拒绝，但叫什么名字不影响转发。
# 凭据 api_key 写在 provider 一级，本块的所有端点共用这一份。
#
# 一条端点由三件事构成：地址、协议、它提供哪些模型。
# 「哪些模型属于哪条端点」必须写在同一条端点里——把 endpoint 与 model 平铺在 provider
# 一级会丢掉这层归属关系，nova 不接受那种写法，因为两条端点各自的模型就无从判断了。

# 单端点渠道：端点指令直接写在 provider 一级，它们描述这条渠道的默认端点。
provider openai {
    # 完整地址，含协议段与端点路径。
    # nova 没有「base + 相对路径」那种拆开写的形态：一条上游只有一个地址，
    # 换供应商时改这一行即可。漏写端点路径通常不会被上游明确回绝，而是回一个 301
    # 或 404 页面，排查起来比写错地址更费劲，因此这里要求写全。
    url https://api.openai.com/v1/chat/completions

    # 从环境变量读入凭据，避免明文写进配置文件：
    #   OPENAI_API_KEY=sk-xxx nova run -c Novafile
    # env 变量未设置或为空都会报错，不会被当成空密钥放行。
    api_key {env.OPENAI_API_KEY}

    # 上游线协议。省略时从 url 末段推导：
    #   /chat/completions → openai_chat
    #   /responses        → openai_responses
    #   /messages         → anthropic_messages
    # 写了就必须与推导结果一致，不一致会指回这一行报错——地址与协议各说各话时，
    # 网关按哪种格式与上游通信就成了一个没有正确答案的问题。
    protocol openai_chat

    # 单次上游调用的超时（缺省 60s）。
    timeout 60s

    # 对外模型名。客户端请求里的 model 只用来选路，不会照转给上游：
    #   model gpt-5                    对外名与上游名相同；
    #   model gpt-5 gpt-5-2025-01-01   对外名 gpt-5，发往上游时改写成后者。
    model gpt-5
    model gpt-5-mini
}

# 多端点渠道：一份凭据、多条端点。
# 写在 provider 一级的那条是默认端点，其余用 `endpoint <地址> { ... }` 描述——
# 块头就是这条端点的地址，块内因此不再写 url。
provider relay {
    api_key {env.RELAY_API_KEY}

    # 默认端点：同一个中转站的 OpenAI 线格式接口。
    url https://relay.example.com/v1/chat/completions
    model gpt-5

    # 另一条端点：同一个凭据、同一个站点，但走 Anthropic 线格式。
    # protocol 不写也能从地址末段推导出来，这里写出来是为了让意图显式。
    # 上游模型名与对外名不同，因此写成两个记号。
    endpoint https://relay.example.com/v1/messages {
        protocol anthropic_messages
        model claude-sonnet-4 claude-sonnet-4-20250514
    }
}

# 只想要具名端点、不想要默认端点时，provider 一级什么端点指令都不写：
#
# provider both {
#     api_key {env.BOTH_API_KEY}
#
#     endpoint https://both.example.com/v1/chat/completions {
#         model gpt-5
#     }
#     endpoint https://both.example.com/v1/messages {
#         model claude-sonnet-4
#     }
# }

# ── 选路与回退 ───────────────────────────────────────────────────────────────
#
# 同一个对外名出现在多个端点下，它们就是这个名字下的候选，按声明顺序依次尝试：
# 上面 openai 与 relay 都提供 gpt-5，因此客户端发 gpt-5 时先试 openai，
# 失败且可重试时再试 relay。想调换优先级就调换这两块的先后。
#
# 同一个端点内重复声明同一个对外名是配置错误：那两条候选除了上游模型名之外没有区别，
# 而「谁该先试」在配置里没有表达，静默取其一只会让人以为写的那条生效了。
#
# 客户端的 model 命中不了任何对外名时返回 model_not_found。
# 网关不会「猜一条渠道」转发：把请求发给一个碰巧存在的上游，比明确回绝更难排查。
#
# 客户端协议由请求路径决定（/v1/chat/completions、/v1/responses、/v1/messages），
# 与端点协议不一致时由网关转换，配置里不需要声明这件事。

# ── 拆分文件 ─────────────────────────────────────────────────────────────────
#
# 渠道多了就拆成一个文件一个渠道，主配置里只留下面这一行。
# 相对路径相对于写下这一行的文件（不是进程的工作目录），因此配置从别处加载也不会跑偏；
# 一条 import 至多一个通配符（* 或 ?），不命中任何文件只警告，不会让网关起不来。
#
# import provider/*

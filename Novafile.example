# nova 配置示例。
#
# 复制到 ${XDG_CONFIG_HOME:-$HOME/.config}/nova/Novafile 即为缺省配置，
# 或用 `nova run -c <路径>`、环境变量 NOVA_CONFIG 指向别处。
#
# 语法要点：
#   - `#` 到行尾是注释；
#   - 全局指令直接写在顶层，不套花括号；
#   - 一行一条指令，形态是「指令名 取值」；
#   - 取值含空白时用双引号包住，引号内 `\"` 与 `\\` 是转义。

# 这份配置按哪一代语法书写。
# 省略时按本二进制实现的最高代数解析，并记一条提示；
# 写出来的代数超出本二进制支持的区间时，nova 在解析任何指令之前就失败。
version 1

# 日志级别：debug / info / warn / error（缺省 info）。
log_level info

# 数据面监听地址（缺省 :8080）。
listen :8080

# 管理端点地址（缺省 localhost:2026）。
# `nova run` 除了数据面之外还会在这个地址上多监听一个管理端点，
# `nova reload` 按它把「重新加载配置」投递进来。
# 管理端点没有鉴权，能连上它的人就能改写这份运行中的配置，因此缺省只绑回环；
# 绑到非回环地址会记一条警告。
admin localhost:2026

# nova 配置示例。
#
# 复制到 ${XDG_CONFIG_HOME:-$HOME/.config}/nova/Novafile 即为缺省配置，
# 或用 `nova run -c <路径>`、环境变量 NOVA_CONFIG 指向别处。
#
# 语法要点：
#   - `#` 到行尾是注释；
#   - 指令直接写在顶层，一行一条；只有要绑定「地址 + 它提供哪些模型」时才用花括号；
#   - 一行是「指令名 取值...」，取值含空白时用双引号包住，引号内 `\"` 与 `\\` 是转义；
#   - 取值里的 {env.NAME} 在加载时替换为环境变量 NAME 的取值。
#
# 用 `nova config check -c Novafile` 可以在不启动、不连上游的前提下校验这份文件。

# 这份配置按哪一代语法书写。
# 省略时按本二进制实现的最高代数解析，并记一条提示；写出来的代数超出本二进制支持的
# 区间时，nova 在解析任何指令之前就失败，并说明是文件声明的代数高、还是本二进制太旧。
version 1

# 日志级别：debug / info / warn / error（缺省 info）。
#
# 它决定「哪些记录被输出」，不决定记录长什么样：
#   - 访问日志按 HTTP 状态码分档：5xx 记 error、4xx 记 warn、其余记 info；
#   - 上游尝试按结果分档：成功 info、失败 warn、客户端取消 debug
#     （取消记 debug 是有意的：长流场景下客户端主动断开很常见，记 warn 会把真故障淹没）。
#
# 启动横幅不受它影响：横幅回答的是「这个进程在用哪份配置跑」，
# 挂到 log_level 上会让一个 log_level error 的实例看不出自己监听在哪。
log_level info

# 日志格式：text / json（缺省 text）。
#
#   - text 给人读：一行一条，字段顺序固定，同协议不写协议、同模型不写模型、
#     用量只写非零子项；失败时上游的状态码与响应片段另起一行缩进排。
#     它因此是不可逆的，不能当数据源。
#   - json 给机器读：字段齐全，用量收在一个 usage 对象里，时间戳是 RFC3339。
#     重定向到文件或喂给采集器时用它。
#
# 终端能不能显示颜色不是配置项，而是运行时判定：
# 输出落在终端上、未设 NO_COLOR、且 TERM 不是 dumb 时才着色。
log_format text

# 数据面监听地址（缺省 127.0.0.1:8080，只绑回环）。客户端请求从这个地址进来。
# 要对内网或公网服务就写 listen :8080 或某个具体地址；
# 那时若没有 client_key，会记一条「谁都能用这份配置里的上游凭据」的警告。
listen 127.0.0.1:8080

# 管理端点地址（缺省 localhost:2026）。
# `nova run` 除了数据面之外还会在这个地址上多监听一个管理端点，`nova reload` 按它把
# 「重新加载配置」投递进来。它没有鉴权：能连上它的人就能改写这份运行中的配置，
# 因此缺省只绑回环；绑到非回环地址会记一条警告。
admin 127.0.0.1:2026

# 客户端凭据：允许调用这个网关的 key，可写多条。
# 客户端用 `Authorization: Bearer <key>` 或 `x-api-key: <key>` 提交，任一匹配即放行。
# 不写这一条就是不鉴权——那种配置只在 listen 也绑回环时才安全，否则会记一条警告。
client_key {env.NOVA_CLIENT_KEY}

# ── 上游渠道 ─────────────────────────────────────────────────────────────────
#
# `provider <名>` 描述一条上游渠道。名字只用于日志与错误定位，不参与选路，
# 因此重名会被拒绝，但叫什么名字不影响转发。
# 凭据 api_key 写在 provider 一级，本块的所有端点共用它；写多条就是多个账号，
# 见下面「一个渠道多个账号」一节。
#
# 一条端点由三件事构成：地址、协议、它提供哪些模型。
# 「哪些模型属于哪条端点」必须写在同一条端点里——把 endpoint 与 model 平铺在 provider
# 一级会丢掉这层归属关系，nova 不接受那种写法，因为两条端点各自的模型就无从判断了。

# 单端点渠道：端点指令直接写在 provider 一级，它们描述这条渠道的默认端点。
provider openai {
    # 完整地址，含协议段与端点路径。
    # nova 没有「base + 相对路径」那种拆开写的形态：一条上游只有一个地址，
    # 换供应商时改这一行即可。漏写端点路径通常不会被上游明确回绝，而是回一个 301
    # 或 404 页面，排查起来比写错地址更费劲，因此这里要求写全。
    url https://api.openai.com/v1/chat/completions

    # 从环境变量读入凭据，避免明文写进配置文件：
    #   OPENAI_API_KEY=sk-xxx nova run -c Novafile
    # env 变量未设置或为空都会报错，不会被当成空密钥放行。
    api_key {env.OPENAI_API_KEY}

    # 上游线协议。省略时从 url 末段推导：
    #   /chat/completions      → openai_chat
    #   /responses             → openai_responses
    #   /messages              → anthropic_messages
    #   :generateContent       → gemini
    #   :streamGenerateContent → gemini
    # 写了就必须与推导结果一致，不一致会指回这一行报错——地址与协议各说各话时，
    # 网关按哪种格式与上游通信就成了一个没有正确答案的问题。
    protocol openai_chat

    # 单次上游调用的超时（缺省 60s）。
    timeout 60s

    # 对外模型名。客户端请求里的 model 只用来选路，不会照转给上游：
    #   model gpt-5                    对外名与上游名相同；
    #   model gpt-5 gpt-5-2025-01-01   对外名 gpt-5，发往上游时改写成后者。
    # 两个记号都按字面量使用，不做通配匹配（名字里含 * 或 ? 会记一条提醒）；
    # 按模式筛上游清单请用下面「模型自动发现与过滤」一节里的 allow / deny。
    model gpt-5
    model gpt-5-mini
}

# 多端点渠道：一份凭据、多条端点。
# 写在 provider 一级的那条是默认端点，其余用 `endpoint <地址> { ... }` 描述——
# 块头就是这条端点的地址，块内因此不再写 url。
provider relay {
    api_key {env.RELAY_API_KEY}

    # 默认端点：同一个中转站的 OpenAI 线格式接口。
    url https://relay.example.com/v1/chat/completions
    model gpt-5

    # 另一条端点：同一个凭据、同一个站点，但走 Anthropic 线格式。
    # protocol 不写也能从地址末段推导出来，这里写出来是为了让意图显式。
    # 上游模型名与对外名不同，因此写成两个记号。
    endpoint https://relay.example.com/v1/messages {
        protocol anthropic_messages
        model claude-sonnet-4 claude-sonnet-4-20250514
    }
}

# Gemini 渠道。
# Gemini 把模型名与动作（是否流式）都写在请求路径上：
#   /v1beta/models/{model}:generateContent
#   /v1beta/models/{model}:streamGenerateContent?alt=sse
# 请求体里没有这两项，因此 url 用 {model} 指代本次请求的模型名，并且必须加引号——
# 不加引号时 { 会被词法器当成块开启，取值被切成多段。
# 网关按本次请求是否流式改写地址末段（generateContent 与 streamGenerateContent 互换，
# 流式另加 alt=sse），凭据以 x-goog-api-key 注入。
#
# 本版不支持在 Gemini 端点上写 discover：清单响应的形状与 OpenAI / Anthropic 不同，
# 且地址里带占位符、推不出清单地址；模型用 model 逐条声明。
#
# provider gemini {
#     api_key {env.GEMINI_API_KEY}
#
#     url "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"
#     model gemini-2.5-flash
#     model gemini-2.5-pro
# }
#
# Gemini 也可以作为客户端协议：
#   POST /v1beta/models/<模型>:generateContent
#   POST /v1beta/models/<模型>:streamGenerateContent
# 模型名取 models/ 前缀之后的部分，与其它协议一样按对外名选路。

# 只想要具名端点、不想要默认端点时，provider 一级什么端点指令都不写：
#
# provider both {
#     api_key {env.BOTH_API_KEY}
#
#     endpoint https://both.example.com/v1/chat/completions {
#         model gpt-5
#     }
#     endpoint https://both.example.com/v1/messages {
#         model claude-sonnet-4
#     }
# }

# ── 一个渠道多个账号 ───────────────────────────────────────────────
#
# api_key 可以写多条，一条一个账号：它们共用本块的地址、协议、超时与模型声明，
# 只有凭据不同。加一个账号就是复制一行。
#
# provider openai {
#     api_key {env.OPENAI_KEY_1}
#     api_key {env.OPENAI_KEY_2}
#     url https://api.openai.com/v1/chat/completions
#     model gpt-5
# }
#
# 不写 balance 时按声明顺序调度：前面的账号失败且可重试，才换后面的。
#
# 写 balance 时按权重轮询分摊：每次请求把起点前移一个位置，链尾仍保留全部账号，
# 因此分摊在正常情况下生效、故障时照常回退。权重写在 api_key 的取值后面，
# 省略即 1；下面两行表示每轮里第一个账号轮到三次、第二个账号轮到一次。
#
# provider openai {
#     api_key {env.OPENAI_KEY_1} 3
#     api_key {env.OPENAI_KEY_2}
#     balance
#     url https://api.openai.com/v1/chat/completions
#     model gpt-5
# }
#
# 写了权重却没写 balance 时权重没有作用，单账号写 balance 时没有可分摊的对象，
# 两种都记一条提醒。
#
# 账号多了就单独放一个文件，用 import 拼进来：被导入的文件就是一段 provider 块体，
# 因此走同一套词法、注释与 {env.NAME}，写错的一行也报出池文件自己的位置。
# 一条 glob 内的文件按文件名字典序拼接，文件名前缀因此决定账号顺序。
#
# provider openai {
#     import accounts/openai-*.nova
#     url https://api.openai.com/v1/chat/completions
#     model gpt-5
# }
#
# accounts/openai-01.nova:
#     api_key {env.OPENAI_KEY_1}
#     api_key {env.OPENAI_KEY_2}

# ── 跨渠道分摊与回退 ──────────────────────────────────
#
# 同一个对外名落在多条渠道上时，缺省按渠道的声明顺序回退：前面那条失败且可重试，
# 才换下一条。要让它们分摊流量就用顶层 route 块声明候选与规则。
#
# route <对外名模式> {
#     balance                      # 可选：主用候选按权重轮询分摊
#     provider <渠道名> [<权重>]…  # 主用候选，一行可列多个
#     fallback <渠道名> [<权重>]…  # 回退候选，主用全部失败后才轮到
# }
#
# 候选按三段的固定顺序拼成一条链：
#   1. provider 行：主用候选，按书写顺序；写 balance 时按权重轮转起点
#   2. fallback 行：显式回退候选，主用候选全部失败之后才轮到，不参与轮转
#   3. 规则没提到的渠道：按声明顺序接在最后兜底
# 「主用全部失败才切换」因此是结构上的事实，而不是靠权重或运气。
#
# 模式不含 * / ? 时就是那一个名字，含通配时匹配一组名字。匹配大小写敏感（对外名
# 本身是精确匹配的），多条规则按声明顺序取第一条命中（更具体的写在前面）。
#
# route deepseek* {
#     balance
#     provider relay-a 3
#     provider relay-b 1
#     fallback relay-c
# }
#
# 上面的 relay-a 与 relay-b 按 3:1 轮转，它们的每一条账号都失败之后才轮到 relay-c。
# 分摊只改起点，链尾一个候选都不丢。
#
# 一行可以列多个渠道名（各权重 1）：provider relay-a relay-b。权重写在它所属
# 渠道名之后，因此渠道名不能是纯数字。
#
# 不写 balance 时主用段按书写顺序回退，用来重排优先级：
#
# route deepseek-chat {
#     provider relay-b
#     provider relay-a
# }
#
# 同一个渠道的多条端点候选作为一个整体移动：先试完这条渠道的全部端点，再换下一条。
# 命中规则的模型不再做「同协议候选优先」那条隐式排序：规则写下的顺序就是最终顺序。
# 一条规则没有命中任何对外名、或规则里的某个渠道没有提供匹配该模式的模型时，
# 加载会各记一条提醒。

# ── 模型自动发现与过滤 ─────────────────────────────────────────────
#
# 中转站与聚合网关单条端点下有几十到几百个模型，逐条抄写既容易抄错，也会与上游
# 真正可用的集合随时间漂移。discover 把端点的模型集合交给上游清单接口，
# allow / deny 决定其中哪些暴露给客户端。
#
# provider aggregator {
#     api_key {env.AGGREGATOR_API_KEY}
#
#     url https://open.bigmodel.cn/api/coding/paas/v4/chat/completions
#
#     # 省略地址时从本端点的 url 推导：裁掉协议端点段，再拼 /models。
#     # 版本根原样保留，因此 /v1、/api/coding/paas/v4、/api/v3 走同一条规则，
#     # /v1/messages 也推出 /v1/models。清单不在这条规则上时显式写地址。
#     discover
#
#     # 过滤模式匹配整个模型 id，两端隐式锚定：gpt* 是「以 gpt 开头」，
#     # openai/gpt-4o 要用 openai/gpt-*；* 可以跨 /，? 匹配一个字符，大小写不敏感。
#     # 一条 allow 都不写表示全部保留，但启动时会记一条提醒；deny 优先于 allow。
#     allow gpt-5*
#     allow claude-*
#     deny *-preview
#
#     # 改名：把清单里的上游 id 按模式改写成对外名，可写多条、第一条命中即生效。
#     # 上游模式必须含恰好一个 *（它决定捕获哪一段），对外名模式用捕获值填充，两边都不收 ?。
#     # 改名是替换：原名不再对客户端存在；两条清单项改名后撞同一个对外名会报错；
#     # 一条规则没命中任何清单项时记一条提醒。
#     # 下面这一条把上游的短名统一加供应商前缀。
#     expose * sensenova/*
#
#     # 显式声明的模型永远生效、不参与过滤；与发现项同名时以显式那条为准，
#     # 于是可以借它改写上游名。
#     model gpt-5 gpt-5-2025-01-01
#
#     # discover / allow / deny 都是端点作用域，写在 provider 一级只作用于默认端点。
#     # 多端点想共享同一套规则时，用 import 引入一个只含 allow / deny 行的文件。
# }
#
# 发现只在启动与 reload 时各做一次，运行中不自动刷新。失败时：端点有显式模型就退回
# 它们并记一条 error，没有显式模型则装配失败（reload 失败时旧配置继续服务）。
# 清单响应自动识别 OpenAI 与 Anthropic 两种形状，字段统一归一化；
# 清单自述还有下一页时记一条提醒，本版不翻页。
#
# 客户端可以直接问网关有哪些模型：GET /v1/models 按 anthropic-version 头区分形状，
# 带该头回 Anthropic 形状，其余回 OpenAI 形状，与其它路径一样要过 client_key。
# 想在动手前看清目录用 `nova models -c Novafile --verbose`（会连上游）。

# ── 选路与回退 ───────────────────────────────────────────────────────────────
#
# 同一个对外名出现在多个端点下，它们就是这个名字下的候选，按声明顺序依次尝试：
# 上面 openai 与 relay 都提供 gpt-5，因此客户端发 gpt-5 时先试 openai，
# 失败且可重试时再试 relay。想调换优先级就调换这两块的先后。
#
# 同一个端点内重复声明同一个对外名是配置错误：那两条候选除了上游模型名之外没有区别，
# 而「谁该先试」在配置里没有表达，静默取其一只会让人以为写的那条生效了。
#
# 客户端的 model 命中不了任何对外名时返回 model_not_found。
# 网关不会「猜一条渠道」转发：把请求发给一个碰巧存在的上游，比明确回绝更难排查。
#
# 客户端协议由请求路径决定（/v1/chat/completions、/v1/responses、/v1/messages），
# 与端点协议不一致时由网关转换，配置里不需要声明这件事。

# ── 拆分文件 ─────────────────────────────────────────────────────────────────
#
# 渠道多了就拆成一个文件一个渠道，主配置里只留下面这一行。
# 相对路径相对于写下这一行的文件（不是进程的工作目录），因此配置从别处加载也不会跑偏；
# 一条 import 至多一个通配符（* 或 ?），不命中任何文件只警告，不会让网关起不来。
#
# import provider/*
